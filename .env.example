# Copy this file to .env.local and fill in the values from Firebase Console.

FIREBASE_API_KEY=...
FIREBASE_AUTH_DOMAIN=...
FIREBASE_PROJECT_ID=...
FIREBASE_STORAGE_BUCKET=...
FIREBASE_MESSAGING_SENDER_ID=...
FIREBASE_APP_ID=...

# Optional
FIREBASE_WARNING_COLLECTION=siteBanner
FIREBASE_WARNING_DOCUMENT=current